[Unit]
Description=туннель ledweb на v3 (панель управления лентой снаружи)
After=network-online.target ledweb.service
Wants=network-online.target

[Service]
Type=simple
# -N не запускает команду, -R пробрасывает порт с v3 на локальный демон.
# RemoteForward 127.0.0.1:8191 — слушаем только на localhost v3, наружу не
# светится: gatewayports no на сервере, и мы туда не лезем
ExecStart=/usr/bin/ssh -F %h/.ssh/ledweb-tunnel \
    -N \
    -R 127.0.0.1:8191:127.0.0.1:8099 \
    -o ServerAliveInterval=20 \
    -o ServerAliveCountMax=3 \
    -o ConnectTimeout=10 \
    -o ExitOnForwardFailure=yes \
    -o BatchMode=yes \
    example-host
Restart=always
RestartSec=5
# ssh не должен мешать systemctl stop ждать вечно
KillMode=process
TimeoutStopSec=10

[Install]
WantedBy=default.target
